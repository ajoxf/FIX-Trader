# Copy to .streamlit/secrets.toml and fill the TT-provisioned endpoints.
# Never commit the copied file or store a password in fixapp.py.
[application]
environment = "UAT"
mock_mode = false
enable_live_order_submission = false

[fix_order]
host = "fixorderrouting-ext-uat-cert.trade.tt"
port = 11502
sender_comp_id = "AJUATORDER"
target_comp_id = "TT"
# Use only the identifier TT has provisioned for tag 116. It may be AJUAT or 33986.
on_behalf_of_sub_id = "AJUAT"
password = "SET_IN_LOCAL_SECRETS_ONLY"
account = "AJ_account"

[fix_market_data]
host = "fixmarketdata-ext-uat-cert.trade.tt"
port = 11503
sender_comp_id = "AJUATMARKET"
target_comp_id = "TT"
on_behalf_of_sub_id = "AJUAT"
password = "SET_IN_LOCAL_SECRETS_ONLY"
